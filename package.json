{
  "name": "image-stitch",
  "version": "1.3.0",
  "description": "Stitch images together efficiently with multi-format support (PNG, JPEG, HEIC), streaming, for node.js and web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jburnhams/image-stitch.git"
  },
  "homepage": "https://jburnhams.github.io/image-stitch/",
  "bugs": {
    "url": "https://github.com/jburnhams/image-stitch/issues"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "deno": "./deno/mod.ts",
      "browser": "./dist/bundles/image-stitch.esm.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./bundle": {
      "types": "./dist/types/bundle.d.ts",
      "default": "./dist/bundles/image-stitch.esm.js"
    },
    "./browser": {
      "default": "./dist/browser/image-stitch.min.js"
    },
    "./decoders/png": {
      "types": "./dist/types/decoders/png.d.ts",
      "default": "./dist/esm/decoders/png.js"
    },
    "./decoders/jpeg": {
      "types": "./dist/types/decoders/jpeg.d.ts",
      "default": "./dist/esm/decoders/jpeg.js"
    },
    "./decoders/heic": {
      "types": "./dist/types/decoders/heic.d.ts",
      "default": "./dist/esm/decoders/heic.js"
    },
    "./deno": "./deno/mod.ts",
    "./node": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "browser": "dist/bundles/image-stitch.esm.js",
  "unpkg": "dist/browser/image-stitch.min.js",
  "jsdelivr": "dist/browser/image-stitch.min.js",
  "files": [
    "dist/esm",
    "dist/cjs",
    "dist/bundles",
    "dist/browser",
    "dist/types",
    "deno",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:bundles": "node scripts/build-bundles.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:bundles",
    "build:tests": "tsc -p tsconfig.tests.json",
    "build:docs": "npm run build && node scripts/build-browser-bundle.js",
    "test:unit": "npm run build:tests && node --expose-gc --test build/tests/tests/unit/*.test.js",
    "test:integration": "npm run build:docs && npm run build:tests && node --expose-gc --test build/tests/tests/integration/*.test.js",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration",
    "smoke:esm": "node scripts/smoke-esm.mjs",
    "smoke:cjs": "node scripts/smoke-cjs.cjs",
    "smoke": "npm run smoke:esm && npm run smoke:cjs",
    "coverage": "npm run build:tests && c8 node --expose-gc --test build/tests/tests/unit/*.test.js",
    "size": "npm run build && node scripts/check-bundle-size.mjs",
    "prepublishOnly": "npm run build",
    "lint": "biome check . && oxlint --type-aware --deny-warnings src",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit"
  },
  "keywords": [
    "png",
    "jpeg",
    "heic",
    "heif",
    "image",
    "concatenate",
    "merge",
    "streaming",
    "canvas-free",
    "multi-format",
    "image-processing"
  ],
  "author": "Jonathan Burnhams",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "heic-decode": "^2.1.0",
    "libheif-js": "^1.23.5",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "jpeg-encoder-wasm": "^0.1.2",
    "jpeg-js": "^0.4.4",
    "pako": "^3.0.3"
  },
  "peerDependencies": {
    "heic-decode": "^2.0.0",
    "libheif-js": "^1.17.0",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "libheif-js": {
      "optional": true
    },
    "heic-decode": {
      "optional": true
    }
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
